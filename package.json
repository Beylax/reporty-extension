{
  "name": "reporty",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@reporty/web",
    "dev:extension": "npm run dev --workspace=@reporty/extension",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace=@reporty/web",
    "test": "npm run test --workspace=@reporty/shared"
  }
}
