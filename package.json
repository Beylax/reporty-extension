{
  "name": "reporty",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:extension:production": "WXT_API_URL=https://reporty-extension.vercel.app npm run build --workspace=@reporty/extension",
    "zip:extension:production": "WXT_API_URL=https://reporty-extension.vercel.app npm run zip --workspace=@reporty/extension && node scripts/copy-extension-zip.mjs",
    "dev:web": "npm run dev --workspace=@reporty/web",
    "dev:extension": "npm run dev --workspace=@reporty/extension",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace=@reporty/web",
    "test": "npm run test --workspace=@reporty/shared && npm run test:db && node --experimental-strip-types --test scripts/notification-polling.test.mjs scripts/bulk-reports.test.mjs scripts/report-table-order.test.mjs && npm run test:widget",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:extension": "npm run build --workspace=@reporty/extension && node --test scripts/extension-lifecycle.test.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "test:widget": "npm run build:widget && node --experimental-strip-types --test scripts/widget-loader.test.mjs scripts/widget-installation.test.mjs scripts/capture-tab.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
